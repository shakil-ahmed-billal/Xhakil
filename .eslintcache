"line":1,"column":10,"nodeType":"3038","messageId":"3039","endLine":1,"endColumn":12,"suggestions":"3138"},{"ruleId":"3106","severity":2,"message":"3107","line":34,"column":29,"nodeType":"3108","endLine":34,"endColumn":41,"suppressions":"3139"},{"ruleId":"3106","severity":2,"message":"3110","line":35,"column":5,"nodeType":"3108","endLine":35,"endColumn":20,"suppressions":"3140"},"@typescript-eslint/ban-ts-comment","Do not use \"@ts-nocheck\" because it alters compilation errors.","Line","tsDirectiveComment",["3141"],"@typescript-eslint/no-explicit-any","Unexpected any. Specify a different type.","TSAnyKeyword","unexpectedAny",["3142","3143"],["3144"],"@typescript-eslint/no-unused-vars","'_Input' is defined but never used.","Identifier","unusedVar",["3145"],["3146"],["3147","3148"],["3149"],"react-hooks/set-state-in-effect","Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\n/Users/shakilahmedbillal/Desktop/Main Projact/Xhakil/src/components/charts/time-series-chart-shell.tsx:163:5\n  161 |   useEffect(() => {\n  162 |     // eslint-disable-next-line react-hooks/set-state-in-effect\n> 163 |     setRevealEpoch((n) => n + 1)\n      |     ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  164 |     setIsLoaded(false)\n  165 |     const timer = setTimeout(() => {\n  166 |       setIsLoaded(true)",["3150"],"react-hooks/refs","Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/shakilahmedbillal/Desktop/Main Projact/Xhakil/src/components/charts/tooltip/chart-tooltip.tsx:128:21\n  126 |   }, [tooltipData, barXAccessor, xAccessor])\n  127 |\n> 128 |   const container = containerRef.current\n      |                     ^^^^^^^^^^^^^^^^^^^^ Passing a ref to a function may read its value during render\n  129 |   if (!(mounted && container)) {\n  130 |     return null\n  131 |   }",["3151"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/shakilahmedbillal/Desktop/Main Projact/Xhakil/src/components/charts/tooltip/chart-tooltip.tsx:129:9\n  127 |\n  128 |   const container = containerRef.current\n> 129 |   if (!(mounted && container)) {\n      |         ^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  130 |     return null\n  131 |   }\n  132 |\n\nTo initialize a ref only once, check that the ref is null with the pattern `if (ref.current == null) { ref.current = ... }`",["3152"],"@typescript-eslint/no-require-imports","A `require()` style import is forbidden.","CallExpression","noRequireImports",["3153"],"@typescript-eslint/consistent-type-imports","`import()` type annotations are forbidden.","TSImportType","noImportTypeAnnotations",["3154"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/shakilahmedbillal/Desktop/Main Projact/Xhakil/src/components/charts/tooltip/date-ticker.tsx:63:27\n  61 |\n  62 |   if (currentMonthIndex >= 0) {\n> 63 |     const isFirstRender = prevMonthIndexRef.current === -1\n     |                           ^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  64 |     const monthChanged = prevMonthIndexRef.current !== currentMonthIndex\n  65 |     if (isFirstRender || monthChanged) {\n  66 |       monthY.set(-currentMonthIndex * TICKER_ITEM_HEIGHT)",["3155"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/shakilahmedbillal/Desktop/Main Projact/Xhakil/src/components/charts/tooltip/date-ticker.tsx:64:26\n  62 |   if (currentMonthIndex >= 0) {\n  63 |     const isFirstRender = prevMonthIndexRef.current === -1\n> 64 |     const monthChanged = prevMonthIndexRef.current !== currentMonthIndex\n     |                          ^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  65 |     if (isFirstRender || monthChanged) {\n  66 |       monthY.set(-currentMonthIndex * TICKER_ITEM_HEIGHT)\n  67 |       prevMonthIndexRef.current = currentMonthIndex",["3156"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/shakilahmedbillal/Desktop/Main Projact/Xhakil/src/components/charts/tooltip/date-ticker.tsx:67:7\n  65 |     if (isFirstRender || monthChanged) {\n  66 |       monthY.set(-currentMonthIndex * TICKER_ITEM_HEIGHT)\n> 67 |       prevMonthIndexRef.current = currentMonthIndex\n     |       ^^^^^^^^^^^^^^^^^^^^^^^^^ Cannot update ref during render\n  68 |     }\n  69 |   }\n  70 |",["3157"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/shakilahmedbillal/Desktop/Main Projact/Xhakil/src/components/charts/tooltip/tooltip-box.tsx:63:14\n  61 |   const animatedTop = useSpring(y, springConfig)\n  62 |\n> 63 |   const tw = tooltipWidthRef.current\n     |              ^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  64 |   const th = tooltipHeightRef.current\n  65 |   const shouldFlipX = x + tw + offset > containerWidth\n  66 |   const targetX = shouldFlipX ? x - offset - tw : x + offset",["3158"],["3159"],"Error: Cannot access refs during render\n\nReact refs are values that are not needed for rendering. Refs should only be accessed outside of render, such as in event handlers or effects. Accessing a ref value (the `current` property) during render can cause your component not to update as expected (https://react.dev/reference/react/useRef).\n\n/Users/shakilahmedbillal/Desktop/Main Projact/Xhakil/src/components/charts/tooltip/tooltip-box.tsx:64:14\n  62 |\n  63 |   const tw = tooltipWidthRef.current\n> 64 |   const th = tooltipHeightRef.current\n     |              ^^^^^^^^^^^^^^^^^^^^^^^^ Cannot access ref value during render\n  65 |   const shouldFlipX = x + tw + offset > containerWidth\n  66 |   const targetX = shouldFlipX ? x - offset - tw : x + offset\n  6