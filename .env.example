# ==============================================================================
# Environment Variables Example for xhakil.site / xhakil.vercel.app
# Duplicate this file as .env and fill in your actual credentials.
# ==============================================================================

# Site URL configuration
APP_URL=http://localhost:3000

# GitHub API & Contributions
GITHUB_API_TOKEN=ghp_dummy_github_api_token_here
GITHUB_CONTRIBUTIONS_API_URL=https://github-contributions-api.jogruber.de

# EmailJS Contact Form (https://www.emailjs.com/)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_dummy_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_dummy_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=public_key_dummy

# Analytics: PostHog (https://posthog.com/)
NEXT_PUBLIC_POSTHOG_KEY=phc_dummy_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com

# Analytics: OpenPanel (https://openpanel.dev/)
NEXT_PUBLIC_OPENPANEL_CLIENT_ID=dummy_openpanel_client_id

# shadcn Registry Configuration
NEXT_PUBLIC_REGISTRY_NAMESPACE=@shakil-ahmed-billal
NEXT_PUBLIC_REGISTRY_NAMESPACE_URL=https://xhakil.site/r
